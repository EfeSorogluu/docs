    "responses": {
      "BadRequest": { "description": "Invalid request: `validation_failed`, `checkout_line_items_invalid`, `checkout_player_invalid`, `checkout_return_url_not_allowed`, `checkout_metadata_invalid`, `idempotency_key_required`, `crafter_version_unsupported`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "`api_key_invalid`: missing, malformed or revoked key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "`api_key_wrong_type`, `api_key_exposed`, `checkout_origin_not_allowed`, `plan_feature_unavailable`, `plan_limit_reached`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "`checkout_session_not_found` (also when the key belongs to another store or mode, or the client secret is wrong).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "`idempotency_key_reused`, `idempotency_in_progress`, `checkout_session_not_open`, `checkout_payment_in_progress`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "TooManyRequests": { "description": "`too_many_requests`: per-key, per-minute limit of your plan. Wait for `Retry-After` seconds.", "headers": { "Retry-After": { "schema": { "type": "integer" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
