{
  "openapi": "3.0.3",
  "info": {
    "title": "CrafterPayments API",
    "version": "2026-12",
    "description": "Public, versioned headless checkout API. Authenticate with a store API key (`Authorization: Bearer cp_sk_…` or `cp_pk_…`). Successful responses return the object directly; errors use `{ \"error\": { type, message, param, details, requestId } }`. Every response carries `X-Request-Id` and `Crafter-Version`."
  },
  "servers": [
    { "url": "https://api.crafterpayments.com", "description": "Production" }
  ],
  "security": [{ "secretKey": [] }],
  "tags": [
    { "name": "Checkout sessions" },
    { "name": "Health" }
  ],
  "paths": {
    "/v1/checkout/sessions": {
      "post": {
        "tags": ["Checkout sessions"],
        "summary": "Create a checkout session",
        "description": "Creates a checkout session for catalog products of the store. Prices come from the store catalog; the request has no price fields. `amountTotal` and `currency` are `null` at creation: tax is calculated on the hosted payment page from the buyer's billing country. Requires a secret key and an `Idempotency-Key` header.",
        "operationId": "createCheckoutSession",
        "security": [{ "secretKey": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/CrafterVersion" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCheckoutSessionRequest" },
              "example": {
                "lineItems": [{ "productId": "prod_123", "quantity": 1 }],
                "customer": {
                  "email": "player@example.com",
                  "externalId": "user_42",
                  "player": { "type": "minecraft_java", "username": "Notch" }
                },
                "successUrl": "https://shop.example.com/thanks?session={CHECKOUT_SESSION_ID}",
                "cancelUrl": "https://shop.example.com/cart",
                "clientReferenceId": "order-1001",
                "metadata": { "campaign": "winter" }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created. A replayed request (same `Idempotency-Key`, same body) returns the first response with the `Idempotent-Replayed: true` header.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" },
              "Crafter-Version": { "$ref": "#/components/headers/CrafterVersion" },
              "Idempotent-Replayed": { "schema": { "type": "string", "enum": ["true"] }, "description": "Present only on a replayed response." }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutSession" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/checkout/sessions/{id}": {
      "get": {
        "tags": ["Checkout sessions"],
        "summary": "Retrieve a checkout session",
        "description": "Returns the full session. Use this (or the `checkout.completed` webhook) as the source of truth before fulfilling an order. Requires a secret key.",
        "operationId": "retrieveCheckoutSession",
        "security": [{ "secretKey": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/SessionId" },
          { "$ref": "#/components/parameters/CrafterVersion" }
        ],
        "responses": {
          "200": { "description": "The session.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutSession" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/checkout/sessions/{id}/public": {
      "get": {
        "tags": ["Checkout sessions"],
        "summary": "Read session status (browser)",
        "description": "Status-only read that can be called from a browser with the publishable key and the session's `clientSecret`. When the request has an `Origin` header, the origin must be in the store's allowed origins.",
        "operationId": "retrieveCheckoutSessionPublic",
        "security": [{ "publishableKey": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/SessionId" },
          { "name": "X-Client-Secret", "in": "header", "required": true, "schema": { "type": "string" }, "description": "`clientSecret` of the session (`cs_…_secret_…`)." },
          { "$ref": "#/components/parameters/CrafterVersion" }
        ],
        "responses": {
          "200": { "description": "Session status.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutSessionPublic" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/checkout/sessions/{id}/cancel": {
      "post": {
        "tags": ["Checkout sessions"],
        "summary": "Cancel a checkout session",
        "description": "Cancels an open session. Calling it again on a canceled session returns the session unchanged. A session that is complete or expired, or whose payment is being processed, cannot be canceled (409).",
        "operationId": "cancelCheckoutSession",
        "security": [{ "secretKey": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/SessionId" },
          { "$ref": "#/components/parameters/CrafterVersion" }
        ],
        "responses": {
          "200": { "description": "The canceled session.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutSession" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "description": "No authentication.",
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "API is up.",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string", "example": "ok" }, "version": { "type": "string", "example": "2026-12" } } } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "secretKey": { "type": "http", "scheme": "bearer", "description": "Secret key `cp_sk_test_…` or `cp_sk_live_…`. Server-side only; a request with a browser `Origin` header is rejected with `api_key_exposed`." },
      "publishableKey": { "type": "http", "scheme": "bearer", "description": "Publishable key `cp_pk_test_…` or `cp_pk_live_…`. Safe to use in the browser, only for the `/public` endpoint." }
    },
    "parameters": {
      "SessionId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^cs_(test|live)_[A-Za-z0-9]{22,40}$" }, "description": "Session id, for example `cs_live_…`." },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 255 }, "description": "Unique per request (for example a UUID). Kept for 24 hours per API key." },
      "CrafterVersion": { "name": "Crafter-Version", "in": "header", "required": false, "schema": { "type": "string", "enum": ["2026-12"] }, "description": "API version. Defaults to the latest version." }
    },
    "headers": {
      "XRequestId": { "schema": { "type": "string", "example": "req_4f1c…" }, "description": "Request id. Include it when you contact support." },
      "CrafterVersion": { "schema": { "type": "string", "example": "2026-12" }, "description": "Version used for this response." }
    },
    "schemas": {
      "LineItemInput": {
        "type": "object",
        "required": ["productId", "quantity"],
        "additionalProperties": false,
        "properties": {
          "productId": { "type": "string", "maxLength": 64, "description": "Product id in the store catalog." },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 99 }
        }
      },
      "Player": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "maxLength": 40, "description": "Player identity type of the store's game integration (for example `minecraft_java`, `steam64`)." },
          "username": { "type": "string", "maxLength": 64, "nullable": true, "description": "Required for name-based types (for example Minecraft)." },
          "id": { "type": "string", "maxLength": 64, "nullable": true, "description": "Required for `steam64`, `cfx` and `roblox`." },
          "uuid": { "type": "string", "maxLength": 40, "nullable": true, "description": "Optional, Minecraft only." }
        }
      },
      "CustomerInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": { "type": "string", "maxLength": 254, "nullable": true },
          "externalId": { "type": "string", "maxLength": 128, "nullable": true, "description": "Your own user id." },
          "player": { "$ref": "#/components/schemas/Player" }
        }
      },
      "CreateCheckoutSessionRequest": {
        "type": "object",
        "required": ["lineItems"],
        "additionalProperties": false,
        "description": "Unknown fields are rejected (`validation_failed`, `should_not_exist`).",
        "properties": {
          "lineItems": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/components/schemas/LineItemInput" } },
          "customer": { "$ref": "#/components/schemas/CustomerInput" },
          "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Za-z]{2})?$", "example": "en" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "A hint only. The display currency is decided by the server." },
          "uiMode": { "type": "string", "enum": ["hosted", "embedded"], "default": "hosted", "description": "`embedded` is not available on the Free plan." },
          "successUrl": { "type": "string", "maxLength": 2000, "description": "Required when `uiMode` is `hosted`. Must be on an allowed origin. `{CHECKOUT_SESSION_ID}` is replaced with the session id." },
          "cancelUrl": { "type": "string", "maxLength": 2000, "description": "Must be on an allowed origin." },
          "allowCoupons": { "type": "boolean", "default": true },
          "couponCode": { "type": "string", "maxLength": 64, "nullable": true },
          "expiresInSeconds": { "type": "integer", "minimum": 900, "maximum": 86400, "default": 1800 },
          "clientReferenceId": { "type": "string", "maxLength": 200, "nullable": true },
          "metadata": { "type": "object", "maxProperties": 20, "additionalProperties": { "type": "string", "maxLength": 500 }, "description": "Up to 20 keys matching `^[A-Za-z0-9_.-]{1,40}$`, string values up to 500 characters. Values that look like card numbers are rejected." }
        }
      },
      "LineItem": {
        "type": "object",
        "properties": {
          "productId": { "type": "string" },
          "name": { "type": "string" },
          "quantity": { "type": "integer" },
          "unitAmount": { "type": "number", "description": "Catalog unit price after product discount, in `storeCurrency`." },
          "currency": { "type": "string", "description": "Same as `storeCurrency`." }
        }
      },
      "CheckoutSession": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "cs_live_…" },
          "object": { "type": "string", "enum": ["checkout.session"] },
          "livemode": { "type": "boolean" },
          "status": { "type": "string", "enum": ["open", "processing", "complete", "expired", "canceled"] },
          "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "no_payment_required", "refunded", "partially_refunded", "disputed"] },
          "uiMode": { "type": "string", "enum": ["hosted", "embedded"] },
          "url": { "type": "string", "example": "https://checkout.crafterpayments.com/c/cs_live_…", "description": "Hosted payment page. Redirect the buyer here." },
          "clientSecret": { "type": "string", "description": "Used with the publishable key for the `/public` read and the embedded mode. Do not log it." },
          "expiresAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "storeCurrency": { "type": "string", "example": "USD" },
          "amountSubtotal": { "type": "number", "description": "Sum of line items at catalog price in `storeCurrency` (before coupon and tax)." },
          "amountTotal": { "type": "number", "nullable": true, "description": "Final amount charged (tax included, after coupon). Null when the session is created: tax is calculated on the payment page from the buyer's billing country." },
          "currency": { "type": "string", "nullable": true, "description": "Charge currency (the buyer's currency). Null until payment starts." },
          "lineItems": { "type": "array", "items": { "$ref": "#/components/schemas/LineItem" } },
          "customer": {
            "type": "object",
            "nullable": true,
            "properties": {
              "email": { "type": "string", "nullable": true },
              "externalId": { "type": "string", "nullable": true },
              "player": { "allOf": [{ "$ref": "#/components/schemas/Player" }], "nullable": true }
            }
          },
          "clientReferenceId": { "type": "string", "nullable": true },
          "metadata": { "type": "object", "additionalProperties": { "type": "string" } },
          "orderId": { "type": "string", "nullable": true },
          "paymentId": { "type": "string", "nullable": true },
          "completedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "CheckoutSessionPublic": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "object": { "type": "string", "enum": ["checkout.session"] },
          "status": { "type": "string", "enum": ["open", "processing", "complete", "expired", "canceled"] },
          "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "no_payment_required", "refunded", "partially_refunded", "disputed"] },
          "amountTotal": { "type": "number", "nullable": true },
          "currency": { "type": "string", "nullable": true },
          "orderId": { "type": "string", "nullable": true },
          "delivery": { "type": "object", "properties": { "status": { "type": "string", "nullable": true, "enum": ["pending", "delivered", "needs_review", "failed", "refunded", null] } } },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["type", "message"],
            "properties": {
              "type": { "type": "string", "description": "Stable, machine-readable error type. Branch on this field.", "example": "checkout_line_items_invalid" },
              "message": { "type": "string", "description": "Human-readable text. It can change; do not parse it." },
              "param": { "type": "string", "description": "The field that caused the error, when there is one." },
              "details": { "type": "object", "additionalProperties": true },
              "requestId": { "type": "string", "example": "req_4f1c…" }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": { "description": "Invalid request: `validation_failed`, `checkout_line_items_invalid`, `checkout_player_invalid`, `checkout_return_url_not_allowed`, `checkout_metadata_invalid`, `idempotency_key_required`, `crafter_version_unsupported`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "`api_key_invalid`: missing, malformed or revoked key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "`api_key_wrong_type`, `api_key_exposed`, `checkout_origin_not_allowed`, `plan_feature_unavailable`, `plan_limit_reached`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "`checkout_session_not_found` (also when the key belongs to another store or mode, or the client secret is wrong).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "`idempotency_key_reused`, `idempotency_in_progress`, `checkout_session_not_open`, `checkout_payment_in_progress`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "TooManyRequests": { "description": "`too_many_requests`: per-key, per-minute limit of your plan. Wait for `Retry-After` seconds.", "headers": { "Retry-After": { "schema": { "type": "integer" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
